{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/nws-state-v1.json",
  "title": "Niwashi State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventory", "infrastructure"],
  "properties": {
    "version": { "const": "nws.state/v1" },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "resourceVersion": { "type": "integer", "minimum": 0 }
      }
    },

    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "description": "Named templates for nodes",
          "additionalProperties": {
            "$ref": "#/$defs/nodeTemplate"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/nodeTemplate" }
          }
        },
        "cluster": {
          "type": "object",
          "description": "Named templates for clusters",
          "additionalProperties": {
            "$ref": "#/$defs/clusterTemplate"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/clusterTemplate" }
          }
        },
        "generator": {
          "type": "object",
          "description": "Named templates for generators",
          "additionalProperties": {
            "$ref": "#/$defs/generatorTemplate"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/generatorTemplate" }
          }
        }
      }
    },

    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "object",
          "description": "Node inventory",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/node" }
          }
        },
        "clusters": {
          "type": "object",
          "description": "Cluster inventory",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/cluster"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/cluster" }
          }
        }
      }
    },

    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generators"],
      "properties": {
        "generators": {
          "type": "object",
          "description": "Instance generator inventory",
          "additionalProperties": {
            "$ref": "#/$defs/generator"
          },
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/generator" }
          }
        }
      }
    },

    "runtime": {
      "type": "object",
      "description": "Runtime observations and execution info (updated by CLI/recipes)",
      "additionalProperties": true,
      "properties": {
        "toolAliases": { "type": "object", "description": "Aliases for recipes referenceable by toolRef" },
        "capabilityBinding": { "type": "object", "description": "Aliases for recipes referenceable as capabilities" },
        "params": { "type": "object" },
        "tool": {
          "type": "object",
          "description": "Map of tool names to tool info objects, written by kind: host installer recipes. Keys correspond to spec.runtime.name. Each value is a free-form object; by convention it includes at least a 'path' field (absolute path to the executable) and optionally a 'version' field. For tools with multiple executables, nested objects are used (e.g. { playbook: { path, version }, galaxy: { path } }).",
          "additionalProperties": { "type": "object" }
        }
      }
    }
  },

  "$defs": {
    "clusterNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": { "$ref": "#/$defs/labels" }
      }
    },

    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "params": { "type": "object" }
      }
    },

    "connection": {
      "type": "object",
      "description": "Transport type is the key (e.g. ssh, winrm). At least one key must be present.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ssh": { "$ref": "#/$defs/sshTransport" },
        "winrm": { "$ref": "#/$defs/winrmTransport" }
      }
    },

    "sshTransport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "user"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "default": 22 },
            "user": { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "enum": ["privateKey"] },
            "privateKeyPath": { "type": "string" },
            "passphraseRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fromEnv": { "type": "string" },
                "fromFile": { "type": "string" }
              }
            }
          }
        },
        "hostKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "enum": ["knownHostsFile"] },
            "knownHostsPath": { "type": "string" }
          }
        }
      }
    },

    "winrmTransport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "user"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "description": "Defaults to 5986 (HTTPS), or 5985 if options.allowInsecureHttp is true" },
            "user": { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "enum": ["ntlm"], "description": "Only NTLM is supported in v1; Kerberos/CredSSP/Basic are not" },
            "passwordRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fromEnv": { "type": "string" },
                "fromFile": { "type": "string" }
              }
            },
            "clientCertPath": { "type": "string", "description": "Reserved for a future \"certificate\" auth method; unused while method is ntlm" },
            "clientKeyPath": { "type": "string", "description": "Reserved for a future \"certificate\" auth method; unused while method is ntlm" }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowInsecureHttp": { "type": "boolean", "default": false, "description": "Opt into plain HTTP (port 5985) instead of HTTPS. Not recommended." },
            "connectTimeoutSec": { "type": "integer", "default": 30 }
          }
        },
        "serverCert": {
          "type": "object",
          "additionalProperties": false,
          "description": "Controls how the WinRM server's TLS certificate is verified.",
          "properties": {
            "insecureSkipVerify": { "type": "boolean", "default": false },
            "caCertPath": { "type": "string" }
          }
        }
      }
    },

    "nodeCommon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": { "$ref": "#/$defs/labels" },
        "capabilities": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/capability" },
              { "type": "string" }
            ]
          }
        }
      }
    },

    "nodeTemplate": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "description": "Single inheritance from another template",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "labels": { "$ref": "#/$defs/labels" },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
          }
        },
        { "$ref": "#/$defs/nodeCommon" }
      ]
    },

    "clusterTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Single inheritance from another template",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "labels": { "$ref": "#/$defs/labels" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" },
          "description": "Cluster-scoped capability requirements only (schema validates type only)"
        },
        "version": { "type": "string" },
        "params": { "type": "object" }
      }
    },

    "generatorTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisioner", "params"],
      "properties": {
        "from": {
          "type": "string",
          "description": "Single inheritance from another template",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "provisioner": {
          "type": "string",
          "description": "The name of the capability that provides this instance."
        },
        "params": {
          "type": "object",
          "description": "Provisioner-specific parameters (e.g. box, image, size, count)"
        }
      }
    },

    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
          "minItems": 1
        },
        "instanceRef": { "type": "string" },
        "instanceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generator": { "type": "string" },
            "instance": { "type": "string" }
          }
        }
      },
      "allOf": [{ "$ref": "#/$defs/nodeCommon" }]
    },

    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "templates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
          "minItems": 1
        },
        "labels": { "$ref": "#/$defs/labels" },
        "nodes": {
          "description": "Either a sequence of node name strings or a mapping of node names to node objects",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" }
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "oneOf": [
                  { "$ref": "#/$defs/clusterNode" },
                  { "type": "null" }
                ]
              }
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" },
          "description": "Cluster-scoped capability requirements only (schema validates type only)"
        },
        "version": { "type": "string" },
        "params": { "type": "object" }
      }
    },

    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisioner"],
      "properties": {
        "templates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
          "minItems": 1
        },
        "provisioner": {
          "type": "string",
          "description": "The name of the capability that provides this generator."
        },
        "params": {
          "type": "object",
          "description": "Provisioner-specific parameters (e.g. box, image, size, count)"
        },
        "instances": {
          "type": "object",
          "description": "Actual provisioned instances",
          "patternProperties": {
            "^[a-zA-Z0-9._-]+$": { "$ref": "#/$defs/pooledInstance" }
          }
        }
      }
    },

    "pooledInstance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "connection": { "$ref": "#/$defs/connection" },
        "addresses": { "type": "array", "items": { "type": "string" } },
        "nodeRef": { "type": ["string", "null"] },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": { "type": "string" },
            "arch": { "type": "string" },
            "data": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    }
  }
}
